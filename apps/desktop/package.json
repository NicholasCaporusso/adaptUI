{
  "name": "@adaptui/desktop",
  "version": "0.1.0",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite build --config vite.electron.config.ts && vite build && electron .",
    "build": "vite build --config vite.electron.config.ts && vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@adaptui/shared-types": "*",
    "@adaptui/security": "*",
    "@adaptui/semantic-model": "*",
    "@adaptui/ui-schema": "*",
    "@adaptui/accessible-ui": "*",
    "@adaptui/browser-core": "*",
    "@adaptui/ai-core": "*",
    "@adaptui/ai-providers": "*",
    "@adaptui/speech-core": "*",
    "@adaptui/command-agent": "*",
    "@adaptui/personalization": "*",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "zustand": "^5.0.3"
  }
}
